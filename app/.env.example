# ── MellowPet App — variáveis de build ───────────────────────────────────────
# Copie para .env.local (ignorado pelo git) para desenvolvimento.
#
# Tudo com prefixo EXPO_PUBLIC_ é embutido no bundle JavaScript e pode ser lido
# por quem descompilar o app. NUNCA coloque aqui um segredo de verdade
# (chave da Anthropic/OpenAI, senha de SMTP) — esses ficam só no servidor.

# URL base da API.
# Em branco: o app tenta descobrir o IP do host do Metro (dispositivo físico na
# mesma rede). Emulador Android: http://10.0.2.2:8000
EXPO_PUBLIC_API_URL=

# Porta usada no fallback de autodetecção.
EXPO_PUBLIC_API_PORT=8000

# Precisa ser igual a API_KEY do api/.env.
# Em builds do EAS, defina como segredo em vez de versionar:
#   npx eas secret:create --name EXPO_PUBLIC_API_KEY --value "<chave>"
EXPO_PUBLIC_API_KEY=
