# MellowPet App — configuração pública de build
# Copie para .env.local. Variáveis EXPO_PUBLIC_* ficam visíveis no bundle;
# nunca coloque senhas, tokens ou outras credenciais aqui.

# URL da API mínima (chat e insight de IA — o resto fala direto com o
# Supabase), sem barra final. Emulador Android: http://10.0.2.2:8000
EXPO_PUBLIC_API_BASE_URL=

# Mesma chave do API_KEY no .env da API. Fica embutida no bundle e é
# extraível de um APK — serve para barrar uso casual por terceiros, não é
# autenticação de usuário (isso é o login, via Supabase Auth).
EXPO_PUBLIC_API_KEY=

# Supabase — banco, auth e realtime. A chave publishable/anon é feita pra ir
# no app (protegida por Row Level Security no banco); nunca coloque a chave
# service_role aqui.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Spotify App Remote — controla o app Spotify instalado no aparelho (Android
# só, por enquanto). Client ID público do painel do Spotify
# (developer.spotify.com/dashboard); o painel também precisa do Redirect URI
# "mellowpet://spotify-callback" e do pacote com.mellowpet.app com o SHA-1 do
# keystore usado para assinar o build.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=

# Motor V2 e classificador visual local.
EXPO_PUBLIC_VISION_V2_ENABLED=true
EXPO_PUBLIC_VISION_V2_PIXEL_CLASSIFIER_ENABLED=true

# Telemetria remota é opt-in e deve permanecer desligada fora de builds internos.
EXPO_PUBLIC_VISION_V2_EVENT_UPLOAD_ENABLED=false
EXPO_PUBLIC_VISION_V2_FEEDBACK_ENABLED=false
EXPO_PUBLIC_VISION_V2_SUPPORT_RULES_ENABLED=false
EXPO_PUBLIC_LEGACY_SERVER_FALLBACK_ENABLED=false

# demo | device | disabled — vazio equivale a "demo" em dev e "disabled" em
# build de produção (ver src/vision/contracts.ts). "device" força o pipeline
# nativo mesmo fora de __DEV__; sem o módulo nativo instalado (Expo Go), a
# câmera mostra só a prévia, sem análise.
EXPO_PUBLIC_VISION_MODE=demo
