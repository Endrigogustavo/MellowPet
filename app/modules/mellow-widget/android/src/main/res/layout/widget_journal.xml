<?xml version="1.0" encoding="utf-8"?>
<!-- DIÁRIO · 4×1 — registrar como foi agora, com as tags mais usadas à mão. -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/widget_journal_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/widget_card_26"
        android:padding="14dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">
        <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_icon_pri"
        android:padding="12dp"
        android:src="@drawable/wi_journal"
        android:contentDescription="@null" />
        <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#1A1A2E"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Como foi agora?" />
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="11sp"
        android:textColor="#9CA3AF"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Uma frase já conta" />
        </LinearLayout>
        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/widget_journal_tag"
        android:textSize="11sp"
        android:textColor="#6B7280"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:background="@drawable/widget_pill_soft"
        android:paddingStart="11dp"
        android:paddingEnd="11dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:text="Alívio" />
    </LinearLayout>
</LinearLayout>
