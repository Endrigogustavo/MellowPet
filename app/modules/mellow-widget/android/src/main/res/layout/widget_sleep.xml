<?xml version="1.0" encoding="utf-8"?>
<!-- SONO · 2×2 — as sete últimas noites e a média da semana. -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/widget_sleep_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/widget_card_bg"
        android:padding="17dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12.5sp"
        android:textColor="#1A1A2E"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Sono" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:baselineAligned="false">
        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/widget_sleep_avg"
        android:textSize="20sp"
        android:textColor="#6C63FF"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="--" />
        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:textSize="10sp"
        android:textColor="#9CA3AF"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="média" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:baselineAligned="false">
        <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom|center_horizontal">
            <ImageView
        android:id="@+id/widget_sleep_b0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/widget_bar_soft"
        android:scaleType="fitXY"
        android:contentDescription="@null" />
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:id="@+id/widget_sleep_d0"
        android:textSize="8.5sp"
        android:textColor="#9CA3AF"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />
        </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom|center_horizontal"
        android:layout_marginStart="5dp">
            <ImageView
        android:id="@+id/widget_sleep_b1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/widget_bar_soft"
        android:scaleType="fitXY"
        android:contentDescription="@null" />
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:id="@+id/widget_sleep_d1"
        android:textSize="8.5sp"
        android:textColor="#9CA3AF"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />
        </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom|center_horizontal"
        android:layout_marginStart="5dp">
            <ImageView
        android:id="@+id/widget_sleep_b2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/widget_bar_soft"
        android:scaleType="fitXY"
        android:contentDescription="@null" />
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:id="@+id/widget_sleep_d2"
        android:textSize="8.5sp"
        android:textColor="#9CA3AF"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />
        </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom|center_horizontal"
        android:layout_marginStart="5dp">
            <ImageView
        android:id="@+id/widget_sleep_b3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/widget_bar_soft"
        android:scaleType="fitXY"
        android:contentDescription="@null" />
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:id="@+id/widget_sleep_d3"
        android:textSize="8.5sp"
        android:textColor="#9CA3AF"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />
        </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom|center_horizontal"
        android:layout_marginStart="5dp">
            <ImageView
        android:id="@+id/widget_sleep_b4"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/widget_bar_soft"
        android:scaleType="fitXY"
        android:contentDescription="@null" />
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:id="@+id/widget_sleep_d4"
        android:textSize="8.5sp"
        android:textColor="#9CA3AF"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />
        </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom|center_horizontal"
        android:layout_marginStart="5dp">
            <ImageView
        android:id="@+id/widget_sleep_b5"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/widget_bar_soft"
        android:scaleType="fitXY"
        android:contentDescription="@null" />
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:id="@+id/widget_sleep_d5"
        android:textSize="8.5sp"
        android:textColor="#9CA3AF"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />
        </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom|center_horizontal"
        android:layout_marginStart="5dp">
            <ImageView
        android:id="@+id/widget_sleep_b6"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/widget_bar_soft"
        android:scaleType="fitXY"
        android:contentDescription="@null" />
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:id="@+id/widget_sleep_d6"
        android:textSize="8.5sp"
        android:textColor="#9CA3AF"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
