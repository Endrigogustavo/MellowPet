<?xml version="1.0" encoding="utf-8"?>
<!-- MÚSICA · 4×2 — cartão colorido pela playlist do momento (design
     PLAYLISTS), faixa em destaque e transporte sobre a cor. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_np_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_pl_neutral"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_np_source"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#B8FFFFFF"
            android:letterSpacing="0.16"
            android:maxLines="1"
            android:text="SPOTIFY" />

        <ImageView
            android:id="@+id/widget_np_eq"
            android:layout_width="20dp"
            android:layout_height="18dp"
            android:src="@drawable/widget_eq"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_np_track"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Nada tocando" />

        <TextView
            android:id="@+id/widget_np_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12.5sp"
            android:textColor="#C7FFFFFF"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Abra o MellowPet para tocar" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_np_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_on_color_btn"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:text="⏮" />

        <TextView
            android:id="@+id/widget_np_playpause"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/widget_white_btn"
            android:gravity="center"
            android:textSize="16sp"
            android:textColor="#55B49A"
            android:text="▶" />

        <TextView
            android:id="@+id/widget_np_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/widget_on_color_btn"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:text="⏭" />

        <ProgressBar
            android:id="@+id/widget_np_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="4dp"
            android:layout_marginStart="12dp"
            android:progressDrawable="@drawable/widget_progress_on_color"
            android:max="100"
            android:progress="0" />
    </LinearLayout>
</LinearLayout>
