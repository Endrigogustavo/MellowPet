<?xml version="1.0" encoding="utf-8"?>
<!-- AGENDA · 4×1 — o próximo compromisso, com dia e observação. -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/widget_agenda_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/widget_card_26"
        android:padding="14dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">
        <LinearLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_icon_soft">
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/widget_agenda_dow"
        android:textSize="9sp"
        android:textColor="#9CA3AF"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="---" />
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/widget_agenda_day"
        android:textSize="16sp"
        android:textColor="#1A1A2E"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="--" />
        </LinearLayout>
        <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:orientation="vertical">
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/widget_agenda_title"
        android:textSize="13sp"
        android:textColor="#1A1A2E"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Nada agendado" />
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:id="@+id/widget_agenda_sub"
        android:textSize="11sp"
        android:textColor="#9CA3AF"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />
        </LinearLayout>
        <ImageView
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:layout_marginStart="8dp"
        android:id="@+id/widget_agenda_dot"
        android:src="@drawable/widget_dot_ok"
        android:contentDescription="@null" />
    </LinearLayout>
</LinearLayout>
