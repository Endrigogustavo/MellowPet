<?xml version="1.0" encoding="utf-8"?>
<!-- ATERRAMENTO · 2×2 — o 5-4-3-2-1 para voltar ao presente. -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/widget_grounding_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/widget_card_bg"
        android:padding="17dp"
        android:gravity="center">

    <ImageView
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:background="@drawable/widget_circle_pri"
        android:padding="18dp"
        android:src="@drawable/wi_ground"
        android:contentDescription="@null" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:id="@+id/widget_ground_title"
        android:textSize="13.5sp"
        android:textColor="#1A1A2E"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="5-4-3-2-1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:id="@+id/widget_ground_sub"
        android:textSize="11sp"
        android:textColor="#9CA3AF"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="voltar ao presente" />
</LinearLayout>
