<?xml version="1.0" encoding="utf-8"?>
<!-- HUMOR · 2×2 — do design "MellowPet Widgets": o Mellow desenhado sobre o
     fundo tingido pela emoção, rótulo e há-quanto-tempo embaixo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_mood_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_tint_neutral"
    android:padding="16dp"
    android:gravity="center">

    <ImageView
        android:id="@+id/widget_mood_pet"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:src="@drawable/mellow_neutral"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/widget_mood_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#1A1A2E"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Neutro" />

    <TextView
        android:id="@+id/widget_mood_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="11sp"
        android:textColor="#6B7280"
        android:maxLines="1"
        android:text="Nível 1" />
</LinearLayout>
