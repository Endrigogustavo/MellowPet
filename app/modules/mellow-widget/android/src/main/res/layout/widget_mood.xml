<?xml version="1.0" encoding="utf-8"?>
<!-- HUMOR · 2×2 — do design "MellowPet Widgets": o Mellow desenhado sobre o
     fundo tingido pela emoção, rótulo e há-quanto-tempo embaixo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_mood_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_tint_neutral"
    android:padding="16dp"
    android:gravity="center">

    <ViewFlipper
        android:id="@+id/widget_mood_pet_anim"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:flipInterval="550"
        android:autoStart="true">
        <ImageView
            android:id="@+id/widget_mood_pet_anim_0"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_float_neutral_0"
            android:contentDescription="@null" />
        <ImageView
            android:id="@+id/widget_mood_pet_anim_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_float_neutral_1"
            android:contentDescription="@null" />
        <ImageView
            android:id="@+id/widget_mood_pet_anim_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_float_neutral_2"
            android:contentDescription="@null" />
        <ImageView
            android:id="@+id/widget_mood_pet_anim_3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_float_neutral_3"
            android:contentDescription="@null" />
        <ImageView
            android:id="@+id/widget_mood_pet_anim_4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_float_neutral_4"
            android:contentDescription="@null" />
        <ImageView
            android:id="@+id/widget_mood_pet_anim_5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_float_neutral_5"
            android:contentDescription="@null" />
        <ImageView
            android:id="@+id/widget_mood_pet_anim_6"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_float_neutral_6"
            android:contentDescription="@null" />
        <ImageView
            android:id="@+id/widget_mood_pet_anim_7"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_float_neutral_7"
            android:contentDescription="@null" />
        <ImageView
            android:id="@+id/widget_mood_pet_anim_8"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_float_neutral_8"
            android:contentDescription="@null" />
        <ImageView
            android:id="@+id/widget_mood_pet_anim_9"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_float_neutral_9"
            android:contentDescription="@null" />
    </ViewFlipper>

    <TextView
        android:id="@+id/widget_mood_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#1A1A2E"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Neutro" />

    <TextView
        android:id="@+id/widget_mood_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="11sp"
        android:textColor="#6B7280"
        android:maxLines="1"
        android:text="Nível 1" />
</LinearLayout>
