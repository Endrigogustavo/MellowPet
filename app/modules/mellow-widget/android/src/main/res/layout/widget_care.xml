<?xml version="1.0" encoding="utf-8"?>
<!-- CUIDAR DO MELLOW · 4×2 — avatar + humor%, com Alimentar/Brincar/Descansar
     abrindo o app já executando a ação. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_care_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_care_pet"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/widget_avatar_bg"
            android:padding="9dp"
            android:src="@drawable/mellow_neutral"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_care_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Mellow" />

            <TextView
                android:id="@+id/widget_care_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="12sp"
                android:textColor="#9CA3AF"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="quer atenção" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/widget_care_mood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#B2BEC3"
                android:text="71%" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#9CA3AF"
                android:letterSpacing="0.06"
                android:text="HUMOR" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/widget_care_feed"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:background="@drawable/widget_action_pri"
            android:gravity="center"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#6C63FF"
            android:text="Alimentar" />

        <TextView
            android:id="@+id/widget_care_play"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_action_soft"
            android:gravity="center"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#6B7280"
            android:text="Brincar" />

        <TextView
            android:id="@+id/widget_care_rest"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_action_soft"
            android:gravity="center"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#6B7280"
            android:text="Descansar" />
    </LinearLayout>
</LinearLayout>
