<?xml version="1.0" encoding="utf-8"?>
<!-- COMO VOCÊ ESTÁ? · 4×2 — as seis carinhas do design, para corrigir a
     leitura do Mellow em um toque. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#1A1A2E"
        android:text="Como você está?" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="11.5sp"
        android:textColor="#9CA3AF"
        android:text="Corrija a leitura em um toque" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_qm_neutral"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="46dp"
            android:background="@drawable/widget_face_slot"
            android:padding="8dp"
            android:src="@drawable/widget_face_neutral"
            android:contentDescription="Neutro" />

        <ImageView
            android:id="@+id/widget_qm_happy"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="46dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/widget_face_slot"
            android:padding="8dp"
            android:src="@drawable/widget_face_happy"
            android:contentDescription="Feliz" />

        <ImageView
            android:id="@+id/widget_qm_anxious"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="46dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/widget_face_slot"
            android:padding="8dp"
            android:src="@drawable/widget_face_anxious"
            android:contentDescription="Ansioso" />

        <ImageView
            android:id="@+id/widget_qm_sad"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="46dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/widget_face_slot"
            android:padding="8dp"
            android:src="@drawable/widget_face_sad"
            android:contentDescription="Triste" />

        <ImageView
            android:id="@+id/widget_qm_surprised"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="46dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/widget_face_slot"
            android:padding="8dp"
            android:src="@drawable/widget_face_surprised"
            android:contentDescription="Surpreso" />

        <ImageView
            android:id="@+id/widget_qm_angry"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="46dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/widget_face_slot"
            android:padding="8dp"
            android:src="@drawable/widget_face_angry"
            android:contentDescription="Com raiva" />
    </LinearLayout>
</LinearLayout>
