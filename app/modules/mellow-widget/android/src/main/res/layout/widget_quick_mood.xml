<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="12dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#8A7FF0"
        android:letterSpacing="0.08"
        android:text="COMO VOCÊ ESTÁ?" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_qm_happy"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:textSize="20sp"
            android:background="@drawable/widget_button_bg"
            android:text="😊" />

        <TextView
            android:id="@+id/widget_qm_sad"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:textSize="20sp"
            android:background="@drawable/widget_button_bg"
            android:text="😢" />

        <TextView
            android:id="@+id/widget_qm_angry"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:textSize="20sp"
            android:background="@drawable/widget_button_bg"
            android:text="😠" />

        <TextView
            android:id="@+id/widget_qm_fearful"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:textSize="20sp"
            android:background="@drawable/widget_button_bg"
            android:text="😰" />

        <TextView
            android:id="@+id/widget_qm_surprised"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:textSize="20sp"
            android:background="@drawable/widget_button_bg"
            android:text="😮" />
    </LinearLayout>
</LinearLayout>
