<?xml version="1.0" encoding="utf-8"?>
<!-- PLANO DE 3 PASSOS · 4×2 — o que fazer agora, na ordem, conforme o estado. -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/widget_plan_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/widget_card_bg"
        android:padding="18dp"
        android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">
        <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#1A1A2E"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_weight="1"
        android:text="Plano para agora" />
        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/widget_plan_emo"
        android:textSize="11sp"
        android:textColor="#9CA3AF"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">
        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/widget_plan_n0"
        android:textSize="11sp"
        android:textColor="#6C63FF"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:background="@drawable/widget_circle_pri"
        android:gravity="center"
        android:minWidth="22dp"
        android:minHeight="22dp"
        android:text="1" />
        <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:id="@+id/widget_plan_t0"
        android:textSize="12.5sp"
        android:textColor="#1A1A2E"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_weight="1"
        android:text="" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">
        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/widget_plan_n1"
        android:textSize="11sp"
        android:textColor="#6C63FF"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:background="@drawable/widget_circle_pri"
        android:gravity="center"
        android:minWidth="22dp"
        android:minHeight="22dp"
        android:text="2" />
        <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:id="@+id/widget_plan_t1"
        android:textSize="12.5sp"
        android:textColor="#1A1A2E"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_weight="1"
        android:text="" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">
        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/widget_plan_n2"
        android:textSize="11sp"
        android:textColor="#6C63FF"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:background="@drawable/widget_circle_pri"
        android:gravity="center"
        android:minWidth="22dp"
        android:minHeight="22dp"
        android:text="3" />
        <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:id="@+id/widget_plan_t2"
        android:textSize="12.5sp"
        android:textColor="#1A1A2E"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_weight="1"
        android:text="" />
    </LinearLayout>
</LinearLayout>
