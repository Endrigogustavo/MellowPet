<?xml version="1.0" encoding="utf-8"?>
<!-- CUIDADOR · 4×2 — quem você acompanha, com bem-estar de cada um e o alerta mais recente. -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/widget_caregiver_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/widget_card_bg"
        android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">
        <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textColor="#9CA3AF"
        android:textStyle="bold"
        android:letterSpacing="0.14"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_weight="1"
        android:text="ACOMPANHANDO" />
        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/widget_cg_status"
        android:textSize="10.5sp"
        android:textColor="#10B981"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="conectado" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">
        <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_slot_18"
        android:padding="12dp">
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/widget_cg_name0"
        android:textSize="12.5sp"
        android:textColor="#1A1A2E"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:id="@+id/widget_cg_state0"
        android:textSize="10sp"
        android:textColor="#9CA3AF"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:id="@+id/widget_cg_wb0"
        android:textSize="19sp"
        android:textColor="#6C63FF"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />
        </LinearLayout>
        <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_slot_18"
        android:padding="12dp"
        android:layout_marginStart="9dp">
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/widget_cg_name1"
        android:textSize="12.5sp"
        android:textColor="#1A1A2E"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:id="@+id/widget_cg_state1"
        android:textSize="10sp"
        android:textColor="#9CA3AF"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:id="@+id/widget_cg_wb1"
        android:textSize="19sp"
        android:textColor="#6C63FF"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:id="@+id/widget_cg_alert"
        android:textSize="11sp"
        android:textColor="#6B7280"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="" />
</LinearLayout>
