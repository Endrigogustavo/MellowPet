<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão de música: cor da playlist + o brilho branco do canto. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <solid android:color="#55B49A" />
      <corners android:radius="32dp" />
    </shape>
  </item>
  <item android:width="180dp" android:height="180dp" android:gravity="top|right">
    <shape android:shape="oval">
      <gradient
          android:type="radial"
          android:gradientRadius="90dp"
          android:startColor="#30FFFFFF"
          android:centerColor="#30FFFFFF"
          android:endColor="#00FFFFFF" />
    </shape>
  </item>
</layer-list>
