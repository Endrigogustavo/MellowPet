# ── MellowPet API — Variáveis de ambiente ────────────────────────────────────
# Copie para .env e preencha. NUNCA versione o .env.
#
# Em APP_ENV=production a API valida esta configuração no boot e se recusa a
# subir se estiver insegura (CORS aberto, sem API key, docs ligado ou DEBUG on).

# ── Ambiente ─────────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
DEBUG=false
LOG_LEVEL=INFO

# ── Servidor ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# Origens permitidas no CORS, separadas por vírgula.
# "*" é recusado quando APP_ENV=production.
CORS_ORIGINS=*
# Produção, exemplo:
# CORS_ORIGINS=https://app.mellowpet.app,https://mellowpet.app

# Ligue só se a API estiver atrás de um proxy que reescreve X-Forwarded-For.
# Com isto ligado sem proxy, qualquer cliente forja o IP e escapa do rate limit.
TRUST_PROXY_HEADERS=false

# ── Autenticação ─────────────────────────────────────────────────────────────
# Chave exigida no header X-API-Key nas rotas /api/v1/*.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# O app mobile envia a mesma chave via EXPO_PUBLIC_API_KEY.
# Atenção: ela fica embutida no bundle do app e é extraível de um APK — serve
# para barrar uso da API por terceiros, não é autenticação de usuário.
API_KEY=

# Desligue o Swagger em produção para não publicar a superfície da API.
ENABLE_DOCS=true

# ── Limites ──────────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=120
MAX_FRAME_BYTES=4000000
MAX_REQUEST_BYTES=6000000

# ── Banco ────────────────────────────────────────────────────────────────────
# Guarda histórico emocional — trate como dado sensível.
DATABASE_URL=sqlite+aiosqlite:///./mellowpet.db

# ── Provedores de IA (opcional) ──────────────────────────────────────────────
# Sem chave, a API responde offline (mensagens de apoio pré-escritas).
#
# AI_PROVIDER escolhe o preferido; os outros com chave viram fallback
# automático se o preferido falhar (cota, rede, chave revogada).
AI_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Modelos de visão ─────────────────────────────────────────────────────────
# Onde ficam em cache os pesos baixados (FER ONNX + MediaPipe). Cada arquivo
# tem SHA-256 conferido no download — ver services/emotion/assets.py.
MELLOWPET_MODEL_DIR=~/.mellowpet/models

# ── Detecção ─────────────────────────────────────────────────────────────────
EMOTION_CONFIDENCE_THRESHOLD=0.45
NO_FACE_ALERT_TIMEOUT_MINUTES=10

# ── Alertas por e-mail ───────────────────────────────────────────────────────
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Destinatários autorizados, separados por vírgula. A API recusa enviar para
# qualquer endereço fora desta lista — sem isso a rota de alerta seria um
# relay aberto de e-mail.
EMERGENCY_CONTACT_EMAIL=
ALERT_EMAIL_ALLOWLIST=
